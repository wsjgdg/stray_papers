# LLM 配置（OpenAI 兼容接口）——复制本文件为 .env 后填入自己的值
VITE_LLM_BASE_URL=https://api.agnes-ai.cn/v1
VITE_LLM_API_KEY=your-api-key-here

# 默认模型（Agnes 文本的推荐免费模型；不填则用源码兜底 agnes-2.5-flash）
VITE_LLM_MODEL=agnes-2.5-flash

# 云端 ASR（SiliconFlow SenseVoice）——仅客户端浏览器直连使用，无后端代理
# 在 https://siliconflow.cn 注册后获取 API Key 填入下方
VITE_SILICONFLOW_API_KEY=your-siliconflow-api-key-here
VITE_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
