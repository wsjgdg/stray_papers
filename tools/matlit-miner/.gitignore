# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is documentation, not a secret -- it must ship with the
# repo so a fresh clone knows which variables exist.
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
/logs/
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# sqlite database (regenerable via bun run db:push)
/db/*.db
/db/*.db-journal

# graphify local state (machine-specific interpreter path)
**/graphify-out/.graphify_python
**/graphify-out/.graphify_root
**/graphify-out/cost.json

# persisted LLM backend credentials (contains API keys — never commit)
/data/user-config.json
