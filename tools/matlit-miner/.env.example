# =============================================================================
# MatLit Miner — Environment Variables
# =============================================================================
# Copy this file to `.env` (or `.env.local`) and edit the values for your
# deployment. Every variable documented here is OPTIONAL unless marked
# `[REQUIRED]` — sensible defaults are baked into the code so the app boots
# out-of-the-box in dev with no .env at all.
#
# The dev server (`bun run dev`) auto-loads `.env` and `.env.local` via
# Next.js's built-in dotenv support. Docker Compose users should pass these
# through `environment:` in `docker-compose.yml` (the included compose file
# already wires up DATABASE_URL + NODE_ENV).
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# Prisma connection string. SQLite is the default (single-file, zero-config).
#
# IMPORTANT — path resolution. Prisma resolves relative SQLite paths from the
# directory containing the schema (`prisma/`), NOT from the project root, and
# this holds for both the CLI (`bun run db:push`) and the runtime query engine
# inside the Next.js server. So a database at `<project-root>/db/custom.db`
# must be written as `file:../db/custom.db`.
#
# Using `file:./db/custom.db` does not error loudly: `db:push` happily creates
# a second database at `prisma/db/custom.db`, and then every API route fails
# to reach it (SQLite error 14: Unable to open the database file).
#
# An absolute path works too; that is what docker-compose.yml uses.
#
# For multi-user / production, switch to PostgreSQL:
#   1. Set DATABASE_URL=postgresql://user:pass@host:5432/matlit
#   2. Change `provider = "sqlite"` → `provider = "postgresql"` in
#      `prisma/schema.prisma`.
#   3. Run `bun run db:push`.
DATABASE_URL=file:../db/custom.db


# -----------------------------------------------------------------------------
# NextAuth.js (auth)
# -----------------------------------------------------------------------------
# Secret used to sign JWTs and encrypt session cookies. Generate a strong
# random string with `openssl rand -base64 32`. If unset, the app falls back
# to a hard-coded dev secret — fine for local play, INSECURE for production.
NEXTAUTH_SECRET=change-me-to-a-random-string

# Canonical base URL of the deployed app. NextAuth uses this to construct
# callback URLs (e.g. for OAuth redirects) and to validate the `next-auth`
# cookie path. Defaults to http://localhost:3000 when not set.
NEXTAUTH_URL=http://localhost:3000

# Canonical public origin of the deployment. Used as Next.js `metadataBase`,
# so relative Open Graph / Twitter image paths (e.g. `/icon.svg`) resolve to
# absolute URLs in social previews. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------
# Overrides the Prisma client log level. Unset by default: development logs
# every SQL query, production logs errors and warnings only.
#
# Accepts a comma-separated subset of Prisma's levels —
# `query`, `info`, `warn`, `error`.
#   PRISMA_LOG=query              → debug SQL on a deployed instance
#   PRISMA_LOG=error              → silence a noisy dev session
#   PRISMA_LOG=query,warn,error   → combine levels
PRISMA_LOG=


# -----------------------------------------------------------------------------
# Realtime service (socket.io mini-service)
# -----------------------------------------------------------------------------
# HTTP base URL of the realtime mini-service (default port 3005). The Next.js
# app POSTs job progress / notification events to `${REALTIME_HTTP_URL}/emit`,
# which then broadcasts them to all connected websocket clients. Falls back
# to http://localhost:3005 if unset.
REALTIME_HTTP_URL=http://localhost:3005


# -----------------------------------------------------------------------------
# CORS — proxy route allowlist
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to consume the `/api/proxy`
# endpoint (which streams external images / PDFs through the server).
# Only origins on this list are reflected back in the
# `Access-Control-Allow-Origin` response header; everything else is blocked
# by the browser. No `*` wildcard is honored.
#
# Default: `http://localhost:3000` only.
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# External API retry config (optional)
# -----------------------------------------------------------------------------
# Each scholarly-API client (Semantic Scholar, CrossRef, OpenAlex) wraps its
# fetches in an exponential-backoff retry loop. These knobs let you tune
# resilience vs. latency without code changes. Defaults shown.
#
# Semantic Scholar (S2) — 429 / 5xx trigger retries.
S2_RETRY_MAX=4
S2_RETRY_BASE_MS=1000

# CrossRef — same semantics.
CROSSREF_RETRY_MAX=4
CROSSREF_RETRY_BASE_MS=1000

# OpenAlex — same semantics.
OPENALEX_RETRY_MAX=4
OPENALEX_RETRY_BASE_MS=1000


# -----------------------------------------------------------------------------
# LLM quota (optional, forward-looking)
# -----------------------------------------------------------------------------
# Default per-identifier daily LLM call limit (24h rolling window). When an
# identifier (user email or client IP) exceeds this, `callLLM` throws a
# `QuotaExceededError` and API routes respond with HTTP 429.
#
# NOTE: The default is currently hardcoded to 100 in `src/lib/llm-quota.ts`
# (`DEFAULT_QUOTA.dailyLimit`). This env var is reserved for a future
# patch that wires the constant through `process.env` so deployments can
# tune the budget without a code change.
LLM_QUOTA_DAILY_LIMIT=100
