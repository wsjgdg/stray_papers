@echo off
chcp 65001 > nul
:: 设置代码页为 UTF-8，解决中文乱码问题，同时兼容 Git 输出的中文

:: ==========================================
:: 如果你的项目目录和此脚本不在同一个地方，请取消下面一行的注释，并修改路径
:: cd /d "D:\Your\Project\Path"
:: ==========================================

echo ==============================
echo 步1：获取远程最新代码 (防止冲突)
echo ==============================
git pull

echo.
echo ==============================
echo 步2：检查本地修改情况
echo ==============================
git status
echo.
echo --- 以下是具体修改的文件统计 ---
git diff --stat

echo.
echo **************************************************************
echo * 请仔细核对以上显示的修改是否是你想要的！
echo * 如果确认无误，将提交并上传；否则直接关闭窗口取消操作。
echo **************************************************************
pause > nul

echo.
echo ==============================
echo 步3：暂存并提交修改
echo ==============================
set /p commit_msg=请输入本次提交信息（直接回车默认为 'update'）: 
if "%commit_msg%"=="" set commit_msg=update

git add .
git commit -m "%commit_msg%"

echo.
echo ==============================
echo 步4：推送到远程仓库
echo ==============================
git push

echo.
echo ==============================
echo 全部流程执行完毕！
echo ==============================
pause
