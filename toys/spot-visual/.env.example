# 运行时（景点模块的图片检索，缺失时自动降级到本地图片池）
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 菜品照片采集（scripts/fetch-dish-photos-cn.mjs）
# 博查 Web Search：https://open.bochaai.com 注册即送试用额度，国内节点
BOCHA_API_KEY=
# 百度「菜品识别」：https://console.bce.baidu.com 有免费额度，用于核验候选图是不是这道菜
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# USDA FoodData Central（口味雷达的钠/糖实测值，免费申请 40 位 key）
FDC_API_KEY=
# TinyFish（只有 search / fetch，鉴权头 X-API-Key）
TINYFISH_API_KEY=
