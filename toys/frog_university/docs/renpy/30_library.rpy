            jump rk_a2_b1_l1
        "「学姐我先走了。明天……也不来了。」"
            $ silence += 0
            $ affinity["moMo"] = affinity.get("moMo", 0) + -2
            if playthrough >= 2:  # 二周目回响：这只蛙记得你上一学期做过同一个选择
                moMo "（她翻开计划表，笔尖已经停在你那一页了）「今天不来了」你上学期说过，「明天也不来了」是这学期的升级版。你的离开是有进度的，我记进表了。"
                moMo "（她说「升级」的时候，笔已经在划了。划一道线不需要抬头。）"
            # 岔路收束语：你名字从她表上划掉那天，桌角多了一张便签。字很重，纸破了一点。
