# ScrollOrchestra AI 环境变量示例（复制为 .env 后填写）
#
# 注意：变量前缀是 AI_（不是 VITE_），由 vite.config.ts 的 envPrefix 暴露给前端。
# 修改后重启 dev server / 重新 build 才生效。
# 主供应商失败时会自动降级到 fallback 供应商（glm-4.7-flash）。

# ---- 主供应商（Agnes AI）----
AI_BASE_URL=https://api.agnes-ai.cn/v1
AI_API_KEY=sk-xxxxxxxx
AI_MODEL=agnes-2.5-flash

# ---- 降级供应商（BigModel / 智谱，主供应商失败时自动启用）----
# 不填 AI_FALLBACK_API_KEY 则关闭降级。
AI_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=glm-4.7-flash
